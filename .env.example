# ---- Server ----
PORT=5000
NODE_ENV=development            # set to "production" in deployment
MONGODB_URI=mongodb://127.0.0.1:27017/etimehr

# ---- Auth (REQUIRED) ----
# Secret used to sign sessions. The server refuses to start unless it is at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h              # sessions are also revocable server-side (logout, password change, deactivation)

# ---- First-run bootstrap of the very first SUPER_ADMIN (optional) ----
# Used ONLY when no super admin exists yet. There is no default account and no default password.
# Remove these three lines after the first start.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=       # >= 10 chars, letters + digits
SEED_SUPERADMIN_NAME=Super Admin

# ---- Networking ----
# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the frontend reaches the API through a same-origin proxy (Vercel rewrite).
CORS_ORIGINS=

# Only ONE instance should run the biometric auto-sync. A database lease enforces it as well,
# but set this to false on any extra instances.
SCHEDULER_ENABLED=true

# ---- e-TimeOffice ----
ETIMESOURCE_BASE_URL=https://api.etimeoffice.com/api

# Location 1: Office / ColorMyles
ETIMESOURCE_OFFICE_CORPORATE_ID=
ETIMESOURCE_OFFICE_USERNAME=
ETIMESOURCE_OFFICE_PASSWORD=

# Location 2: Budigere
ETIMESOURCE_BUDIGERE_CORPORATE_ID=
ETIMESOURCE_BUDIGERE_USERNAME=
ETIMESOURCE_BUDIGERE_PASSWORD=

# Location 3: Bidarahalli
ETIMESOURCE_BIDARAHALLI_CORPORATE_ID=
ETIMESOURCE_BIDARAHALLI_USERNAME=
ETIMESOURCE_BIDARAHALLI_PASSWORD=

# ---- Payslip email (optional; without it the API returns a preview instead of sending) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
